# Copia este archivo a "Caddyfile" y reemplaza el dominio.
# Caddy automáticamente saca un certificado Let's Encrypt y lo renueva.
# Requisito: el dominio debe apuntar al IP del VPS (registro A) ANTES del primer arranque.

track.tudominio.cl {
    reverse_proxy app:3000

    # Logs
    log {
        output stdout
        format console
    }

    # Headers de seguridad básicos
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# Si más adelante quieres exponer otra app en el mismo dominio bajo otro subdominio:
# otra.tudominio.cl {
#     reverse_proxy other-app:4000
# }
