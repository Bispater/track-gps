# Copia este archivo a "Caddyfile" y reemplaza el dominio.
# Caddy automáticamente saca un certificado Let's Encrypt y lo renueva.
# Requisito: el dominio debe apuntar al IP del VPS (registro A) ANTES del primer arranque.

proaseg.cl {
    # La API y el login van al backend Node/Express
    handle /api/* {
        reverse_proxy backend:3000
    }

    # Todo lo demás (el SPA Angular, incl. /login, /resumen, …) lo sirve Nginx
    handle {
        reverse_proxy frontend:80
    }

    encode gzip

    # Logs
    log {
        output stdout
        format console
    }

    # Headers de seguridad básicos
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
